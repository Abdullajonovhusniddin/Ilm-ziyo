import { useState } from "react";

export default function App() {
  const [count, setCount] = useState(0);

  return (
    <div style={{ padding: 20, fontFamily: "sans-serif" }}>
      <h1>Vercel Project 🚀</h1>

      <p>Count: {count}</p>

      <button onClick={() => setCount(count + 1)}>
        + Add
      </button>
    </div>
  );
}